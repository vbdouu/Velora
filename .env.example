# ────────────────────────────────────────────────────────────────
# Velora — Fichier de configuration d'environnement (exemple)
# Copiez ce fichier en ".env" et remplissez les valeurs réelles.
# Ne commitez jamais le fichier .env dans le dépôt Git.
# ────────────────────────────────────────────────────────────────

# ── Serveur ──

# Port d'écoute du serveur Express (défaut : 3000)
PORT=3000

# ── Base de données MySQL ──

# Hôte MySQL (ex : localhost, 127.0.0.1, ou l'adresse d'un serveur distant)
DB_HOST=localhost

# Port MySQL (défaut : 3306)
DB_PORT=3306

# Nom d'utilisateur MySQL
DB_USER=root

# Mot de passe MySQL (laisser vide si pas de mot de passe, ex : XAMPP en local)
DB_PASSWORD=

# Nom de la base de données
DB_NAME=velora_db

# Activer SSL pour la connexion MySQL (true en production, false en local)
DB_SSL=false

# ── Session ──

# Clé secrète utilisée pour signer les cookies de session.
# Doit être une chaîne longue et aléatoire en production.
# Exemple de génération : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=changez_cette_valeur_en_production
